# ==============================================================================
# asanHire Master Environment Configuration Template
# List of all environment variable names (NO REAL VALUES COMMITTED)
# ==============================================================================

# --- Frontend & Public Settings ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase Backend & Database Credentials ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- AI Models & API Keys ---
# NOTE: Model names are environment variables that must be checked against each
# provider's current active model list (run `python scripts/list_models.py`).
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# --- Email Notifications (Resend) ---
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_EMAIL=
DEMO_EMAIL_OVERRIDE=

# --- Security & Token Hashes ---
INTERVIEW_TOKEN_SALT=

# --- Backend Application Settings ---
APP_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXIES=
SHOW_DOCS_IN_PROD=false
RATE_LIMIT_PUBLIC_PER_MINUTE=20
RATE_LIMIT_INTERVIEW_PER_MINUTE=60
MAX_UPLOAD_SIZE_BYTES=5242880
