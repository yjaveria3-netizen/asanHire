GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Email Delivery (Resend)
RESEND_API_KEY=
RESEND_FROM=
DEMO_EMAIL_OVERRIDE=

# Security & Cryptographic Tokens
INTERVIEW_TOKEN_SALT=
