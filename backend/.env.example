# ==============================================================================
# asanHire Backend Environment Variables Template
# List of all environment variable names (NO REAL VALUES COMMITTED)
# ==============================================================================

# Application & Server
APP_ENV=
PORT=
FRONTEND_URL=
BACKEND_CORS_ORIGINS=
TRUSTED_PROXIES=
SHOW_DOCS_IN_PROD=

# Supabase Authentication & Database
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
